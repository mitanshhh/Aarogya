PROJECT_NAME="Aarogya Health Engine"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-jwt-key-change-this-in-production"

# Database Connection
DATABASE_URL=""
INSTANCE_CONNECTION_NAME=""

# CORS Settings (Set to * for testing or your frontend production URL for security)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,*"

# Google Gemini API Key
GEMINI_API_KEY=""
CHAT_NLP_PROVIDER="rules"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_SSL_VERIFY=true

# SMTP Email Credentials (for onboarding staff)
SMTP_EMAIL=""
SMTP_PASSWORD=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_SSL_VERIFY=true
SMTP_FROM_NAME="Aarogya Health Engine"
